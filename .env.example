# ── Backend ────────────────────────────────────────────────────────────────
# PostgreSQL (production / docker-compose)
DATABASE_URL="postgresql://toolgate:toolgate@localhost:5432/toolgate"
# For pure local/dev without Postgres, use SQLite instead:
#   DATABASE_URL="file:./dev.db"
#   (and run prisma commands with --schema prisma/sqlite/schema.prisma)

JWT_SECRET="replace-me"
DEMO_MODE=true
ADMIN_EMAIL="admin@toolgate.dev"
ADMIN_PASSWORD="changeme123"
PORT=4000

# Optional — enables Live Agent Mode (real Anthropic-powered agent)
ANTHROPIC_API_KEY=

# ── Frontend ───────────────────────────────────────────────────────────────
VITE_API_URL="http://localhost:4000"
VITE_SOCKET_URL="http://localhost:4000"