# ── Backend ────────────────────────────────────────────────────────────────
# PostgreSQL (production / docker-compose)
DATABASE_URL="postgresql://toolgate:toolgate@localhost:5432/toolgate"
# For pure local/dev without Postgres, use SQLite instead:
#   DATABASE_URL="file:./dev.db"
#   (and run prisma commands with --schema prisma/sqlite/schema.prisma)

JWT_SECRET="replace-me"
DEMO_MODE=true
ADMIN_EMAIL="admin@toolgate.dev"
ADMIN_PASSWORD="changeme123"
PORT=4000

# ── Optional — enables Live Agent Mode (AG-12) ─────────────────────────────
# Any provider works. Pick one:
#
# 1) OpenAI-compatible (OpenAI, OpenRouter, Groq, DeepSeek, Mistral,
#    Ollama, LM Studio, vLLM, ...) — LLM_BASE_URL defaults to OpenAI.
LLM_API_KEY=
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
#
# 2) Native Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-sonnet-4-5"
#
# Provider selection (default: auto-detect by whichever key is set)
# LLM_PROVIDER="openai" | "anthropic"

# ── Frontend ───────────────────────────────────────────────────────────────
VITE_API_URL="http://localhost:4000"
VITE_SOCKET_URL="http://localhost:4000"